/**
 * Si soft delet proposer hard delte dans le trach
 */
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

///////////////////////////////
/////     Better Auth     /////
///////////////////////////////

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role String @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // soft delete

  // Relations
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  @@index([deletedAt])
  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

////////////////////////
/////     user     /////
////////////////////////

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayOrder Int      @default(0)
  name         String
  bio          String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayOrder])
  @@map("profil")
}

////////////////////////
/////     Blog     /////
////////////////////////

/// Taxonomie 3 niveaux : Theme → Category → SubCategory
model Theme {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  color       String
  icon        String
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categories Category[]
  articles   Article[]

  @@index([order])
  @@map("theme")
}

model Category {
  id          String   @id @default(cuid())
  themeId     String
  slug        String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  theme         Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]
  articles      Article[]

  @@unique([themeId, slug])
  @@index([themeId, order])
  @@map("category")
}

model SubCategory {
  id          String   @id @default(cuid())
  categoryId  String
  slug        String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([categoryId, slug])
  @@index([categoryId, order])
  @@map("sub_category")
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articleTags ArticleTag[]

  @@map("tag")
}

/// Article éditorial
model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  summary        String
  coverImage     String?
  readingTimeMin Int       @default(0)
  viewCount      Int       @default(0)
  featured       Boolean   @default(false)
  authorId       String
  themeId        String
  categoryId     String?
  subCategoryId  String?
  status         String    // draft | published | archived
  visibility     String    // public | private | unlisted
  publishedAt    DateTime?
  order          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  theme       Theme        @relation(fields: [themeId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])

  content   ContentBlock[]
  comments  Comment[]
  likes     Like[]
  tags      ArticleTag[]
  favorites Favorite[]

  @@index([themeId, status])
  @@index([authorId])
  @@index([publishedAt])
  @@map("article")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tag")
}

/// Bloc de contenu hiérarchique (flat tree, parentId racine → null)
model ContentBlock {
  id        String   @id @default(cuid())
  articleId String
  parentId  String?
  order     Int      @default(0)
  type      String   // section | paragraph | image | video | audio | code | embed | document
  payload   String   // JSON sérialisé des champs spécifiques au type
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article  Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent   ContentBlock?  @relation("BlockTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ContentBlock[] @relation("BlockTree")

  @@index([articleId, parentId, order])
  @@map("content_block")
}

/// Commentaire (flat tree, parentId racine → null, soft delete)
model Comment {
  id        String    @id @default(cuid())
  articleId String
  parentId  String?
  authorId  String
  content   String
  order     Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  article  Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentTree")
  likes    Like[]

  @@index([articleId, parentId, order])
  @@map("comment")
}

/// Like polymorphe (article ou commentaire ou post), unicité (target, user)
model Like {
  id         String   @id @default(cuid())
  targetType String   // article | comment | post
  targetId   String
  userId     String
  createdAt  DateTime @default(now())

  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, userId])
  @@index([userId])
  @@map("like")
}

/// Groupe de discussion
model Group {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  coverImage  String?
  visibility  String   // public | private | unlisted
  ownerId     String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     GroupMember[]
  discussions Discussion[]

  @@map("group")
}

model GroupMember {
  groupId  String
  userId   String
  role     String   // owner | moderator | member
  status   String   // active | pending | banned
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_member")
}

model Discussion {
  id        String   @id @default(cuid())
  groupId   String
  title     String
  content   String
  authorId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([groupId, order])
  @@map("discussion")
}

/// Post (flat tree, parentId racine → null, soft delete)
model Post {
  id           String    @id @default(cuid())
  discussionId String
  parentId     String?
  authorId     String
  content      String
  order        Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent     Post?      @relation("PostTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Post[]     @relation("PostTree")
  likes      Like[]

  @@index([discussionId, parentId, order])
  @@map("post")
}

/// Notification in-app (userContent.notifications[])
model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String    // reply | group_invite | group_join_approved | group_new_discussion
  actorId    String
  targetType String    // article | comment | group | discussion | post
  targetId   String
  excerpt    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

/// Dossier de favoris
model FavoriteFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]

  @@index([userId, order])
  @@map("favorite_folder")
}

/// Favori (article dans un dossier ou non classé)
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  folderId  String?
  createdAt DateTime @default(now())

  article Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  folder  FavoriteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, articleId])
  @@index([userId, folderId])
  @@map("favorite")
}

/// Journal d'audit (modération, actions sensibles)
model AuditEntry {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  resourceId String
  metadata   String?  // JSON optionnel
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([resourceId])
  @@map("audit_entry")
}